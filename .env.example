# The SEC requires a User-Agent identifying the caller and carrying contact details.
# Requests without one are rejected.
MARKETSCOPE_SEC_USER_AGENT="MarketScope research your.name@example.com"

# The SEC rate limit is 10 requests per second. The default leaves headroom.
MARKETSCOPE_SEC_REQUESTS_PER_SECOND=8

# Free key from https://fredaccount.stlouisfed.org/apikeys
MARKETSCOPE_FRED_API_KEY=

MARKETSCOPE_CACHE_DIR="data/cache"
MARKETSCOPE_CACHE_TTL_HOURS=24
